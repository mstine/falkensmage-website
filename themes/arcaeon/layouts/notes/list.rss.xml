{{- /* Full-content RSS for /notes/. A note has no title, so items carry none: RSS 2.0 requires
       only a title or a description, and the whole note is the description. */ -}}
{{- $pages := first 50 .RegularPages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Notes from Falken's Mage</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Params.lede }}</description>
    <language>{{ site.Language.Lang }}</language>
    <managingEditor>{{ site.Params.author }}</managingEditor>
    {{ with $pages }}{{ with index . 0 }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}{{ end }}
    {{ with .OutputFormats.Get "rss" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{- range $pages }}
    <item>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ transform.XMLEscape .Content | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
